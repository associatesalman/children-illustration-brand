# Contact and Free Sample form email delivery (server-side only; copy to .env and fill in).
# Never prefix these with VITE_: that would expose them in the browser bundle.

# Internal inbox that receives inquiries. Not shown anywhere on the site.
CONTACT_RECIPIENT_EMAIL=

# Internal inbox for Free Sample requests (/free-sample). Falls back to CONTACT_RECIPIENT_EMAIL when empty.
FREE_SAMPLE_RECIPIENT_EMAIL=

# Sender address verified with your mail provider (for example a no-reply address on your domain).
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=klutzbookpublisher website

# SMTP connection from your transactional email provider.
SMTP_HOST=
SMTP_PORT=587
# "true" for port 465 (implicit TLS); leave empty or "false" for 587 (STARTTLS).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Set to "true" when running behind a reverse proxy so rate limiting uses the visitor's IP.
TRUST_PROXY=

# Public production origin used for canonical and Open Graph URLs, e.g. https://www.yourdomain.com (no trailing slash).
# This one is public by design (VITE_ prefix): it is written into the page. Leave empty until the domain is live.
VITE_SITE_URL=
